{
    "label" : "lock",
    "action" : "/home/xaess/.local/share/quickshell-lockscreen/lock.sh",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch 'hl.dsp.exit()'",
